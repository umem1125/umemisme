---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 border-b border-neutral-200/60 bg-white/80 backdrop-blur dark:border-neutral-800/60 dark:bg-neutral-950/80">
  <div class="mx-auto flex h-14 max-w-3xl items-center justify-between px-4 sm:px-6">
    <!-- Brand Title -->
    <a href="/" class="font-semibold text-neutral-900 hover:text-accent-600 dark:text-neutral-100 dark:hover:text-accent-400 transition-colors">
      {SITE_TITLE}
    </a>

    <!-- Main Navigation & Theme Control -->
    <nav aria-label="Main navigation" class="flex items-center gap-1">
      <HeaderLink href="/">Beranda</HeaderLink>
      <HeaderLink href="/blog">Catatan saya</HeaderLink>
      <div class="mx-2 hidden h-5 w-px bg-neutral-200 dark:bg-neutral-800 sm:block"></div>
      <ThemeToggle />
    </nav>
  </div>
</header>
